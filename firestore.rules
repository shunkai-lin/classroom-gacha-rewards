rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 班級資料：以「班級代碼」當文件 ID。
    // 設計上採用「代碼即密碼」的無登入模式，但仍加上以下防護：
    //  - 禁止 list：不能列舉整個 classes 集合，避免有人一次撈走所有班級的資料
    //  - 限制寫入結構與大小：只允許 students / prizes 兩個欄位，並限制筆數，
    //    防止有人把資料庫當免費儲存空間亂塞或灌爆單一文件
    match /classes/{classId} {
      allow get: if true;
      allow list: if false;
      allow write: if isValidClassData();
    }

    function isValidClassData() {
      let data = request.resource.data;
      return data.keys().hasOnly(['students', 'prizes'])
        && data.students is list
        && data.students.size() <= 300
        && data.prizes is list
        && data.prizes.size() <= 100;
    }

    // 喵喵版（自訂上傳獎品圖片）：獨立 kitty 集合，與 classes 互不干擾。
    // 多一個 imagePrizes 欄位放老師上傳的圖片（已在前端壓縮成小縮圖）。
    match /kitty/{classId} {
      allow get: if true;
      allow list: if false;
      allow write: if isValidKittyData();
    }

    function isValidKittyData() {
      let data = request.resource.data;
      return data.keys().hasOnly(['students', 'prizes', 'imagePrizes'])
        && data.students is list
        && data.students.size() <= 300
        && data.prizes is list
        && data.prizes.size() <= 100
        && data.imagePrizes is list
        && data.imagePrizes.size() <= 40;
    }
  }
}
